# byte code / caches
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# coverage: one data file, or one per process while measuring in parallel
.coverage
.coverage.*
htmlcov/

# virtual environments
.venv/
venv/
env/

# editor / OS noise
.vscode/
.idea/
.DS_Store

# what each example writes when it runs: databases, run state, logs
example/*/transaction/
example/*/transaction.lock

# Rust build artifacts for the optional native masker
mask-rs/target/

# The documentation site, built by mkdocs
/site/

# bauta Studio: the web app's dependencies, and its build, which the
# release builds into the package
studio/web/node_modules/
studio/web/*.tsbuildinfo
bauta/studio/static/
# what Studio and its demo keep when run from a clone
studio-data/
demo-workspace/
